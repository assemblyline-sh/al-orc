# The @finopsbricks/fob-orc client takes credentials EXPLICITLY — fobOrc({ api_key, api_secret }).
# It never reads process.env (see engineering-standards `no-ambient-configuration`),
# and the fob-orc CLI resolves credentials from its config profiles (~/.fob/fob-orc/config.yml).
#
# These vars are only for callers that wire their own env (e.g. a worker's stmClient()-style
# helper) and pass the values in explicitly. Origin-only URL — the client adds /api/v1.
ORCHESTRATOR_URL=https://orchestrator.finopsbricks.com
ORCHESTRATOR_API_KEY=orc_xxxxxxxxxxxxxxxx
ORCHESTRATOR_API_SECRET=yyyyyyyyyyyyyyyyyyyy
