# The @assemblyline/al-orc client takes credentials EXPLICITLY — alOrc({ api_key, api_secret }).
# It never reads process.env, and the al-orc CLI resolves credentials from its config profiles
# (~/.assemblyline/al-orc/config.yml).
#
# These vars are only for callers that wire their own env and pass the values in explicitly.
# Origin-only URL — the client adds /api/v1.
ORCHESTRATOR_URL=https://orchestrator.assemblyline.sh
ORCHESTRATOR_API_KEY=al_xxxxxxxxxxxxxxxxxx
ORCHESTRATOR_API_SECRET=yyyyyyyyyyyyyyyyyyyyyyyy
