{
  "name": "@assemblyline/al-orc",
  "version": "0.3.0",
  "description": "Assembly Line Orchestrator client + al-orc CLI (2-in-1): push lines and stations, run them, read work records.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/assemblyline-sh/al-orc.git"
  },
  "bugs": {
    "url": "https://github.com/assemblyline-sh/al-orc/issues"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "al-orc": "./bin/cli.js"
  },
  "scripts": {
    "start": "node bin/cli.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "typecheck": "tsc -p jsconfig.json",
    "typecheck:watch": "tsc -p jsconfig.json --watch"
  },
  "keywords": [
    "orchestrator",
    "api-client",
    "cli",
    "assembly-line"
  ],
  "license": "Apache-2.0",
  "files": [
    "bin",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.10.1",
    "js-yaml": "^4.1.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/node": "^22.20.1",
    "jest": "^29.7.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "homepage": "https://assemblyline.sh",
  "author": "Assembly Line"
}
